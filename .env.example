# Copy to .env, fill privately, then use Docker Compose. Never commit .env.
ASSISTANT_API_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ASSISTANT_TIMEZONE=Asia/Shanghai
# Single-owner service: messages from approved WeChat users map to this owner.
ASSISTANT_OWNER=owner
WECHAT_CORP_ID=
WECHAT_KF_SECRET=
WECHAT_CALLBACK_TOKEN=
# WeChat supplies a 43-character EncodingAESKey.
WECHAT_ENCODING_AES_KEY=
# Comma-separated external_userid values. Empty means deny all customers.
WECHAT_ALLOWED_USERS=
